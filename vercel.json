{
  "regions": [
    "sin1"
  ],
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/qr/:file",
      "destination": "/api/files?qr=:file"
    },
    {
      "source": "/kyc",
      "destination": "/kyc.html"
    },
    {
      "source": "/ledger",
      "destination": "/kyc.html"
    },
    {
      "source": "/feedback",
      "destination": "/feedback.html"
    },
    {
      "source": "/f",
      "destination": "/feedback.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "30 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://app.thebharatsteelgroup.com https://bsg-hub-one.vercel.app"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(index.html|app.js|app.css|kyc.html|feedback.html|forms.css)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/cron.js": {
      "maxDuration": 300
    },
    "api/crm.js": {
      "maxDuration": 120
    }
  }
}